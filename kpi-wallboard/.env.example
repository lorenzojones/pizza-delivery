# ---------------------------------------------------------------------------
# KPI Wallboard configuration.
# Copy this file to ".env" (next to docker-compose.yml) and edit as needed.
# Every value has a sensible default; with no Aircall credentials the backend
# runs in DEMO mode and synthesises call data so the board works out of the box.
# ---------------------------------------------------------------------------

# --- Aircall API ----------------------------------------------------------
# Create an API key in Aircall: Dashboard > Integrations & API > API Keys.
# The "API ID" is the username and the "API Token" is the password (HTTP Basic).
# Leave BOTH blank to run in demo mode.
AIRCALL_API_ID=
AIRCALL_API_TOKEN=
AIRCALL_BASE_URL=https://api.aircall.io/v1

# --- Data sources ---------------------------------------------------------
# Paths are evaluated INSIDE the backend container (see docker-compose volumes).
SALES_XLSX_PATH=/app/data/sales-sample.xlsx
STAFF_MAPPING_PATH=/app/config/staff-mapping.json

# --- Refresh & display ----------------------------------------------------
REFRESH_INTERVAL_SECONDS=300
DASHBOARD_TITLE=Vent Sales
DASHBOARD_TIMEZONE=Europe/London

# --- KPI scoring weights (need not sum to 1; they are normalised) ---------
WEIGHT_SALES=0.50
WEIGHT_CALLS_OUT=0.25
WEIGHT_CALLS_IN=0.10
WEIGHT_MINUTES=0.15

# --- Excel column mapping -------------------------------------------------
# Set these to match the header cells in YOUR spreadsheet. Matching is
# case- and whitespace-insensitive. Only EXCEL_COL_NAME is required; the
# others are optional and ignored if the column is absent.
EXCEL_SHEET=
EXCEL_COL_NAME=Name
EXCEL_COL_SALES_COUNT=Sales Count
EXCEL_COL_SALES_VALUE=Sales Value
EXCEL_COL_TARGET=Target

# --- Frontend (only used when running the frontend dev server directly) ---
# Base URL the browser uses to reach the API. Empty = same origin (/api/...).
VITE_API_BASE=
